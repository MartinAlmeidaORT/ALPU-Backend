        }

        class UnitOfWork <Implements IUnitOfWork> {
            + UnitOfWork(DatabaseContext context)
            - readonly DatabaseContext _context = context
            - IUserRepository? _users
            - IBroadcasterRepository? _broadcasters
            - IClientRepository? _clients
            - ICountryRepository? _countries
            - IDepartmentRepository? _departments
            - IAlpuServiceRepository? _services
            - IContractRepository? _contracts
            - IBillRepository? _bills
            - ILanguageRepository? _languages
            - ISkillRepository? _skills
            + IUserRepository Users
            + IBroadcasterRepository Broadcasters
            + IClientRepository Clients
            + ICountryRepository Countries
            + IDepartmentRepository Departments
            + IAlpuServiceRepository Services
            + IContractRepository Contracts
            + IBillRepository Bills
            + ILanguageRepository Languages
            + ISkillRepository Skills
            + void Attach<T>(T entity) <where T : class>
            + async Task SaveChangesAsync()
        }

        class UserRepository <RepositoryBase<User>(context), IUserRepository> {
            + UserRepository(DatabaseContext context)
            + IQueryable<User> GetAllUsers()
            + IQueryable<Client> GetAllClients()
            + IQueryable<Broadcaster> GetAllBroadcasters()
            + async Task<User?> GetUserByIdAsync(int id)
            + User DeleteUser(User entity)
            + Task<User?> GetUserByEmailAsync(string email)
            + Task<User?> GetUserByRutAsync(string rut)
            + Task<User?> GetUserByGoogleIdAsync(string googleId)
        }
