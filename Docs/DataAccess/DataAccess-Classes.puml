    package ExternalServices {
        class AmazonS3Service <Implements IAmazonS3Service> {
            {static} + readonly long MaxDemoFileSizeBytes = 5MB
            {static} - readonly string[] ImageExtensions = [".jpg", ".jpeg", ".png", ".webp"]
            {static} - readonly string[] AudioExtensions = [".mp3"]
            {static} - string GetContentType(string extension)
            {static} - string BuildKey(string prefix, string fileName)
            - readonly IAmazonS3 _s3Client = s3Client
            - readonly string _bucketName = config["AWS:BucketName"]!

            + AmazonS3Service(IAmazonS3 s3Client, IConfiguration config)
            + async Task<Result<(string, string)>> SaveBillProofAsync(string fileName, BillType type)
            + async Task<string> SaveContractAsync(byte[] pdfBytes, int contractId)
            + string GetDownloadUrl(string key, int expiryMinutes = 15)
            + async Task<string> MoveContractToCancelledAsync(int contractId)
            + Result<(string Key, string Url, IReadOnlyDictionary<string, string> Fields)> SaveDemoAsync(string fileName, int locutorId)
            + async Task<Result> SaveDemoAsync(string key)
            + string GetDemoPlaybackUrl(string key, int expiryMinutes = 30)
            + async Task DeleteDemoAsync(string key)
            + Result<(string Key, string UploadUrl)> SaveProfilePictureAsync(string fileName, int locutorId)
            + string GetProfilePictureUrl(string key, int expiryMinutes = 15)
            + async Task DeleteProfilePictureAsync(string key)
            - string GetPreSignedPutUrl(string key, string contentType, TimeSpan expiresIn)
        }

        class GoogleAuthService <Implements IGoogleAuthService> {
