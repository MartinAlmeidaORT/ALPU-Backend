            + async Task<GoogleUserInfo?> ExchangeCodeAsync(string code)
            {static} - async Task<GoogleUserInfo?> ValidateGoogleTokenAsync(string token, string clientId)
        }
    }

    package Repositories {
        class AlpuServiceRepository <RepositoryBase<BaseService>(context), IAlpuServiceRepository> {
            + AlpuServiceRepository(DatabaseContext context)
            + IQueryable<BaseService> GetAllServices()
            + IQueryable<VolumeDiscount> GetAllVolumeDiscounts()
            + IQueryable<MultiServiceDiscount> GetAllMultiServiceDiscounts()
            + IQueryable<PriceAdjustment> GetAllPriceAdjustments()
            + async Task<BaseService?> GetServiceByIdAsync(int id)
            + async Task<BaseService?> GetByType(ServiceType service, int? period = null)
            + async Task<VolumeDiscount?> GetVolumeDiscountAsync(ServiceType type, int quantity)
            + async Task<MultiServiceDiscount?> GetMultiMediaDiscountAsync(ServiceType typeA, ServiceType typeB)
        }

        class BillRepository <RepositoryBase<Bill>(context), IBillRepository> {
            + BillRepository(DatabaseContext context)
